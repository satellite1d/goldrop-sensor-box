# Merge into the existing HTTPS virtual host if this domain already has one.
# Certificates must exist and renew separately. No TLS/private keys are included.
server {
    listen 443 ssl;
    server_name r.limanowa.org;
    ssl_certificate /etc/letsencrypt/live/r.limanowa.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/r.limanowa.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /goldrop/ota/manifest.json {
        root /srv;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
        limit_except GET { deny all; }
    }
    location /goldrop/ota/ {
        root /srv;
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
        limit_except GET { deny all; }
    }
}
